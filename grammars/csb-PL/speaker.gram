#JSGF V1.0;
#VUI-VERSION: 0.2.0;
public <S> = Speaker__ (TurnOnOrOff__ <INTENT_1> | IncreaseVolume__ <INTENT_2> | IncreaseVolumeByPercent__ <INTENT_3> | DecreaseVolume__ <INTENT_4> | DecreaseVolumeByPercent__ <INTENT_5>| MuteOn__ <INTENT_6> | MuteOff__ <INTENT_7>);

#INTENTS
##1) TURN ON OR OFF
<INTENT_1> = <INTENT_1_L0TC> | <INTENT_1_L1TC> | <INTENT_1_L2TC> | <INTENT_1_REPHRASE>;
<INTENT_1_L0TC> = <INTENT_1_L0TC_1> | <INTENT_1_L0TC_2>;
<INTENT_1_L0TC_1> = L0TC__ verb_pattern_01__ włącz [mój] głosnik [dlô mie | za mie];
<INTENT_1_L0TC_2> = L0TC__ verb_pattern_02__ wëłącz [mój] głosnik [dlô mie | za mie];

<INTENT_1_L1TC> = <INTENT_1_L1TC_1> | <INTENT_1_L1TC_2>;
<INTENT_1_L1TC_1> = L1TC__ verb_pattern_01__ (pòmóż mie i | zrób cos dlô mie i | bądz tak miłi i) włącz [mój] głosnik;
<INTENT_1_L1TC_2> = L1TC__ verb_pattern_02__ (pòmóż mie i | zrób cos dlô mie i | bądz tak miłi i) wëłącz [mój] głosnik;

<INTENT_1_L2TC> = <INTENT_1_L2TC_1> | <INTENT_1_L2TC_2>;
<INTENT_1_L2TC_1> = L2TC__ verb_pattern_01__ òdłącz [mój] głosnik;
<INTENT_1_L2TC_2> = L2TC__ verb_pattern_02__ pòdłącz [mój] głosnik;

<INTENT_1_REPHRASE> = <INTENT_1_REPHRASE_1> | <INTENT_1_REPHRASE_2>;
<INTENT_1_REPHRASE_1> = REPHRASE__ verb_pattern_01__ cësza;
<INTENT_1_REPHRASE_2> = REPHRASE__ verb_pattern_02__ pùsc jakąs mùzykã;

##2) INCREASE VOLUME
<INTENT_2> = <INTENT_2_L0TC> | <INTENT_2_L1TC> | <INTENT_2_L2TC> | <INTENT_2_REPHRASE>;
<INTENT_2_L0TC> = <INTENT_2_L0TC_1> | <INTENT_2_L0TC_2>;
<INTENT_2_L0TC_1> = L0TC__ verb_pattern_01__ zwiãksz (përznã | kąsk) głosnosc [[mòjégò] głosnika];
<INTENT_2_L0TC_2> = L0TC__ verb_pattern_02__ zrób (përznã | kąsk) głosni [[mój] głosnik];

<INTENT_2_L1TC> = L1TC__ verb_pattern_01__ (përznã | kąsk) głosni;

<INTENT_2_L2TC> = <INTENT_2_L2TC_1> | <INTENT_2_L2TC_2> | <INTENT_2_L2TC_3>;
<INTENT_2_L2TC_1> = L2TC__ verb_pattern_01__ zgłosni (përznã | kąsk) [[mój] głosnik];
<INTENT_2_L2TC_2> = L2TC__ verb_pattern_02__ pòdgłosni (përznã | kąsk) [[mój] głosnik];
<INTENT_2_L2TC_3> = L2TC__ verb_pattern_03__ wez zrób (përznã | kąsk) głosni [[mój] głosnik];

<INTENT_2_REPHRASE> = REPHRASE__ verb_pattern_01__ je (përznã | kąsk) za cëchò;

##3) INCREASE VOLUME MORE
<INTENT_3> = <INTENT_3_L0TC> | <INTENT_3_L1TC> | <INTENT_3_L2TC> | <INTENT_3_REPHRASE>;
<INTENT_3_L0TC> = <INTENT_3_L0TC_1> | <INTENT_3_L0TC_2>;
<INTENT_3_L0TC_1> = L0TC__ verb_pattern_01__ zwiãksz głosnosc [[mòjégò] głosnika];
<INTENT_3_L0TC_2> = L0TC__ verb_pattern_02__ zrób głosni [[mój] głosnik];

<INTENT_3_L1TC> = <INTENT_3_L1TC_1> | <INTENT_3_L1TC_2>;
<INTENT_3_L1TC_1> = L1TC__ verb_pattern_01__ zwiãksz głosnosc ò <PERCENT> [procent];
<INTENT_3_L1TC_2> = L1TC__ verb_pattern_02__ zrób głosni ò <PERCENT> [procent];

<INTENT_3_L2TC> = <INTENT_3_L2TC_1> | <INTENT_3_L2TC_2> | <INTENT_3_L2TC_3>;
<INTENT_3_L2TC_1> = L2TC__ verb_pattern_01__ zgłosni [[mój] głosnik];
<INTENT_3_L2TC_2> = L2TC__ verb_pattern_02__ pòdgłosni [[mój] głosnik];
<INTENT_3_L2TC_3> = L2TC__ verb_pattern_03__ wez zrób głosni [[mój] głosnik];

<INTENT_3_REPHRASE> = REPHRASE__ verb_pattern_01__ je (za | baro) cëchò;

##4) DECREASE VOLUME
<INTENT_4> = <INTENT_4_L0TC> | <INTENT_4_L1TC> | <INTENT_4_L2TC> | <INTENT_4_REPHRASE>;
<INTENT_4_L0TC> = <INTENT_4_L0TC_1> | <INTENT_4_L0TC_2>;
<INTENT_4_L0TC_1> = L0TC__ verb_pattern_01__ scësz (përznã | kąsk) [mój] głosnik;
<INTENT_4_L0TC_2> = L0TC__ verb_pattern_02__ zrób (përznã | kąsk) cëszi;

<INTENT_4_L1TC> = <INTENT_4_L1TC_1> | <INTENT_4_L1TC_2>;
<INTENT_4_L1TC_1> = L1TC__ verb_pattern_01__ zmniész (përznã | kąsk) głosnosc [mòjégò] głosnika;
<INTENT_4_L1TC_2> = L1TC__ verb_pattern_02__ scësz (përznã | kąsk) głosnosc [mòjégò] głosnika;

<INTENT_4_L2TC> = L2TC__ verb_pattern_01__ zredukùj (përznã | kąsk) głosnosc [mòjégò] głosnika;

<INTENT_4_REPHRASE> = REPHRASE__ verb_pattern_01__ je (përznã | kąsk) za głosno;

##5) DECREASE VOLUME MORE
<INTENT_5> = <INTENT_5_L0TC> | <INTENT_5_L1TC> | <INTENT_5_L2TC> | <INTENT_5_REPHRASE>;
<INTENT_5_L0TC> = <INTENT_5_L0TC_1> | <INTENT_5_L0TC_2>;
<INTENT_5_L0TC_1> = L0TC__ verb_pattern_01__ scësz (përznã | kąsk) [mój] głosnik ò <PERCENT> [procent];
<INTENT_5_L0TC_2> = L0TC__ verb_pattern_02__ zrób (përznã | kąsk) cëszi ò <PERCENT> [procent];

<INTENT_5_L1TC> = <INTENT_5_L1TC_1> | <INTENT_5_L1TC_2>;
<INTENT_5_L1TC_1> = L1TC__ verb_pattern_01__ zmniész (përznã | kąsk) głosnosc [mòjégò] głosnika;
<INTENT_5_L1TC_2> = L1TC__ verb_pattern_02__ scësz (përznã | kąsk) głosnosc [mòjégò] głosnika;

<INTENT_5_L2TC> = L2TC__ verb_pattern_01__ zredukùj (përznã | kąsk) głosnosc [mòjégò] głosnika;

<INTENT_5_REPHRASE> = REPHRASE__ verb_pattern_01__ je baro głosno;

##6) MUTE
<INTENT_6> = <INTENT_6_L0TC> | <INTENT_6_L1TC> | <INTENT_6_L2TC> | <INTENT_6_REPHRASE>;
<INTENT_6_L0TC> = L0TC__ verb_pattern_01__ wëcësz [mój] głosnik;

<INTENT_6_L1TC> = L1TC__ verb_pattern_01__ przestóń (òdtwôrzac | grac) [mùzykã];

<INTENT_6_L2TC> = L2TC__ verb_pattern_01__ zatrzymaj òdtwôrzanié [zwãkù | mùzyczi] na [mòjim] głosnikù;

<INTENT_6_REPHRASE> = REPHRASE__ verb_pattern_01__ bądz cëchò;

##7) UNMUTE
<INTENT_7> = <INTENT_7_L0TC> | <INTENT_7_L1TC> | <INTENT_7_L2TC> | <INTENT_7_REPHRASE>;
<INTENT_7_L0TC> = L0TC__ verb_pattern_01__ włącz zwãk [mòjégò głosnika | na mòjim głosnikù];

<INTENT_7_L1TC> = L1TC__ verb_pattern_01__ wznów (zwãk | òdtwôrzanié) na [mòjim] głosnikù;

<INTENT_7_L2TC> = L2TC__ verb_pattern_01__ copni wëcëszenié [mòjégò] głosnika;

<INTENT_7_REPHRASE> = REPHRASE__ verb_pattern_01__ głosnik je wierã [wëłączony | wëcëszony];

#SLOTS
<DEVICE_NAME> = SPEAKER.SLOT.DEVICE_NAME;
<POWER> = SPEAKER.SLOT.POWER;
<PERCENT> = SPEAKER.SLOT.PERCENT;
