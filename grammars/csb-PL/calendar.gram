#JSGF V1.0;
#VUI-VERSION: 0.2.0;
public <S> = Calendar__ (OpenCalendar__ <INTENT_1> | CheckCalendarOnDate__ <INTENT_2> | CheckCalendarEventName__ <INTENT_3> | AddEventWithName__ <INTENT_4> | AddEventOnDateWithName__ <INTENT_5> | NotifyOnEventStart__ <INTENT_6> | NotNotifyOnEventStart__ <INTENT_7> | NotifyOnEventInLocation__ <INTENT_8> | NotNotifyOnEventInLocation__ <INTENT_9> | NotifyWhenEventNameStart__ <INTENT_10>);

#PRECONDITIONS
<WHEN_1> = czedë (spòtkanié | zéńdzenié | wëdarzenié) w [mòjim] <CALENDAR_APP_LOC> sã (rozpòcznie | zacznie);
<WHEN_2> = czedë (spòtkanié | zéńdzenié | wëdarzenié) w [mòjim] <CALENDAR_APP_LOC> w <LOCATION> sã (rozpòcznie | zacznie);
<WHEN_3> = czedë sã zaczinô (spòtkanié | zéńdzenié | wëdarzenié) <EVENT_NAME> (w [mòjim] kalãdôrzu | z [mojégò] kalãdôrza);

#INTENTS
##1) OPEN CALENDAR
<INTENT_1> = <INTENT_1_L0TC> | <INTENT_1_L1TC> | <INTENT_1_L2TC> | <INTENT_1_REPHRASE>;
<INTENT_1_L0TC> = <INTENT_1_L0TC_1> | <INTENT_1_L0TC_2>;
<INTENT_1_L0TC_1> = L0TC__ verb_pattern_01__ pòkôż [mój] <CALENDAR_APP>;
<INTENT_1_L0TC_2> = L0TC__ verb_pattern_02__ òdemkni [mój] <CALENDAR_APP>;

<INTENT_1_L1TC> = L1TC__ verb_pattern_01__ wëswietlë [mój] <CALENDAR_APP>;

<INTENT_1_L1TC> = L2TC__ verb_pattern_01__ wëswietl [mój] <CALENDAR_APP>;

<INTENT_1_L2TC> = L3TC__ verb_pattern_01__ sprôwdz [mój] <CALENDAR_APP>;

<INTENT_1_L3TC> = L4TC__ verb_pattern_01__ sprawdzë [mój] <CALENDAR_APP>;

<INTENT_1_REPHRASE> = REPHRASE__ verb_pattern_01__ chcã òbaczëc co mie dzys czekô;

##2) CHECK CALENDAR IN DATE
<INTENT_2> = <INTENT_2_L0TC> | <INTENT_2_L1TC> | <INTENT_2_L2TC> | <INTENT_2_REPHRASE>;
<INTENT_2_L0TC> = L0TC__ verb_pattern_01__ pòkôż [mòje] (spòtkania | zéńdzenia | planë | wëdarzenia) (na <DATE_NA> | w <DATE_W> | we <DATE_WE>);

<INTENT_2_L1TC> = <INTENT_2_L1TC_1> | <INTENT_2_L1TC_2>;
<INTENT_2_L1TC_1> = L1TC__ verb_pattern_01__ wëswietl [mòje] (spòtkania | zéńdzenia | planë | wëdarzenia) (na <DATE_NA> | w <DATE_W> | we <DATE_WE>);
<INTENT_2_L1TC_2> = L1TC__ verb_pattern_02__ sprôwdz [mòje] (spòtkania | zéńdzenia | planë | wëdarzenia) (na <DATE_NA> | w <DATE_W> | we <DATE_WE>);

<INTENT_2_L2TC> = L2TC__ verb_pattern_01__ pòwiedz jaczé móm (spòtkania | zéńdzenia | planë | wëdarzenia) zaplanowóné (na <DATE_NA> | w <DATE_W> | we <DATE_WE>);

<INTENT_2_REPHRASE> = <INTENT_2_REPHRASE_1> | <INTENT_2_REPHRASE_2>;
<INTENT_2_REPHRASE_1> = REPHRASE__ verb_pattern_01__ co je zaplanowóné (na <DATE_NA>| w <DATE_W> | we <DATE_WE>);
<INTENT_2_REPHRASE_2> = REPHRASE__ verb_pattern_02__ (jaczé | czë) móm (wëdarzenia | spòtkania | zéńdzenia) (na <DATE_NA> | w <DATE_W> | we <DATE_WE>);

##3) CHECK CALENDAR EVENT WITH NAME
<INTENT_3> = <INTENT_3_L0TC> | <INTENT_3_L1TC> | <INTENT_3_L2TC> | <INTENT_3_REPHRASE>;
<INTENT_3_L0TC> = L0TC__ verb_pattern_01__ pòkôż szczegółë [mòjégo] (spòtkania | wëdarzenia | zéńdzenia) [ò nazwie] <EVENT_NAME>;

<INTENT_3_L1TC> = <INTENT_3_L1TC_1> | <INTENT_3_L1TC_2>;
<INTENT_3_L1TC_1> = L1TC__ verb_pattern_01__ wëswietl (([mòje] (spòtkanie | zéńdzenié | planë | wëdarzenié)) | (szczegółë mòjégo (spòtkania | zéńdzenia | planu | wëdarzenia))) [ò nazwie] <EVENT_NAME>;
<INTENT_3_L1TC_2> = L1TC__ verb_pattern_02__ sprôwdz [szczegółë mòjégo | mòje] (spòtkania | wëdarzenia) [ò nazwie] <EVENT_NAME>;

<INTENT_3_L2TC> = L2TC__ verb_pattern_01__ pòwiédz mi ò [szczegółach] <EVENT_NAME>;

<INTENT_3_REPHRASE> = REPHRASE__ verb_pattern_01__ co (je zaplanowóné | jem zaplanowôł | jem zaplanowała) w <EVENT_NAME>;

##4) ADD EVENT
<INTENT_4> = <INTENT_4_L0TC> | <INTENT_4_L1TC> | <INTENT_4_L2TC> | <INTENT_4_REPHRASE>;
<INTENT_4_L0TC> = <INTENT_4_L0TC_1> | <INTENT_4_L0TC_2>;
<INTENT_4_L0TC_1> = L0TC__ verb_pattern_01__ dodôj [nowé] (wëdarzenié | spòtkanié | przëpòmienié) [do kalãdôrza] ò nazwie <EVENT_NAME>;
<INTENT_4_L0TC_2> = L0TC__ verb_pattern_02__ (chcã | mùszã) dodac [nowé] [wëdarzenié | spòtkanié | przëpòmienié] <EVENT_NAME> do [mojégò] <CALENDAR_APP_GEN>;

<INTENT_4_L1TC> = L1TC__ verb_pattern_01__ zapisz [wëdarzenié] <EVENT_NAME> w [mòjim] <CALENDAR_APP_LOC>;

<INTENT_4_L2TC> = <INTENT_4_L2TC_1> | <INTENT_4_L2TC_2>;
<INTENT_4_L2TC_1> = L2TC__ verb_pattern_01__ zanotuj [wëdarzenié] <EVENT_NAME> w [mòjim] <CALENDAR_APP_LOC>;
<INTENT_4_L2TC_2> = L2TC__ verb_pattern_02__ zaznôcz [wëdarzenié] <EVENT_NAME> w [mòjim] <CALENDAR_APP_LOC>;

<INTENT_4_REPHRASE> = REPHRASE__ verb_pattern_01__ wëdarzenié <EVENT_NAME> dodôj do [mòjégo] <CALENDAR_APP_GEN>;

##5) ADD EVENT ON DATE
<INTENT_5> = <INTENT_5_L0TC> | <INTENT_5_L1TC> | <INTENT_5_L2TC> | <INTENT_5_REPHRASE>;
<INTENT_5_L0TC> = <INTENT_5_L0TC_1> | <INTENT_5_L0TC_2>;
<INTENT_5_L0TC_1> = L0TC__ verb_pattern_01__ dodôj [nowé] (wëdarzenié | spòtkanié | zéńdzenié | przëpòmienié | przëbôczenié) [do kalãdôrza] ò nazwie <EVENT_NAME> (na <DATE_NA> | w <DATE_W> | we <DATE_WE>);
<INTENT_5_L0TC_2> = L0TC__ verb_pattern_02__ <DATE_NA> dodôj [nowé] (wëdarzenié | spòtkanié | przëpòmienié) ò nazwie <EVENT_NAME> [do kalãdôrza];

<INTENT_5_L1TC> = L1TC__ verb_pattern_01__  <DATE_NA> zapisz [w kalãdôrzu] [[wëdarzenié | spòtkanié | przëpòmienié | przëbôczenié] ò nazwie] <EVENT_NAME>;

<INTENT_5_L2TC> = <INTENT_5_L2TC_1> | <INTENT_5_L2TC_2>;
<INTENT_5_L2TC_1> = L2TC__ verb_pattern_01__  <DATE_NA> zanotuj [w kalãdôrzu] [[wëdarzenié | spòtkanié | zéńdzenié | przëpòmienié | przëbôczenié] ò nazwie] <EVENT_NAME>;
<INTENT_5_L2TC_2> = L2TC__ verb_pattern_02__  <DATE_NA> zaznacz [w kalãdôrzu] [[wëdarzenié | spòtkanié | zéńdzenié | przëpòmienié | przëbôczenié] ò nazwie] <EVENT_NAME>;

<INTENT_5_REPHRASE> = REPHRASE__ verb_pattern_01__ wëdarzenié <EVENT_NAME> dodôj do [mòjégò] <CALENDAR_APP_GEN> na <DATE_NA>;

##6) NOTIFY ON EVENT START
<INTENT_6> = <INTENT_6_L0TC> | <INTENT_6_L1TC> | <INTENT_6_L2TC> | <INTENT_6_REPHRASE>;
<INTENT_6_L0TC> = L0TC__ verb_pattern_01__ pòwiadóm mie <WHEN_1>;

<INTENT_6_L1TC> = L1TC__ verb_pattern_01__ pòwiédz mie <WHEN_1>;

<INTENT_6_L2TC> = L2TC__ verb_pattern_01__ przëpòmni mie <WHEN_1>;

<INTENT_6_REPHRASE> = REPHRASE__ verb_pattern_01__ dôj mie znac <WHEN_1>;

##7) DONT NOTIFY ON EVENT START
<INTENT_7> = <INTENT_7_L0TC> | <INTENT_7_L1TC> | <INTENT_7_L2TC> | <INTENT_7_REPHRASE>;
<INTENT_7_L0TC> = L0TC__ verb_pattern_01__ nie pòwiadamiôj mie <WHEN_1>;

<INTENT_7_L1TC> = L1TC__ verb_pattern_01__ nie mów mie <WHEN_1>;

<INTENT_7_L2TC> = L2TC__ verb_pattern_01__ nie przëpòminôj mie <WHEN_1>;

<INTENT_7_REPHRASE> = <INTENT_7_REPHRASE_1> | <INTENT_7_REPHRASE_2>;
<INTENT_7_REPHRASE_1> = REPHRASE__ verb_pattern_01__ nie wspòminôj [ò tim] <WHEN_1>;
<INTENT_7_REPHRASE_2> = REPHRASE__ verb_pattern_02__ sedz cëchò <WHEN_1>;

##8) NOTIFY ON EVENT START IN LOCATION
<INTENT_8> = <INTENT_8_L0TC> | <INTENT_8_L1TC> | <INTENT_8_L2TC> | <INTENT_8_REPHRASE>;
<INTENT_8_L0TC> = L0TC__ verb_pattern_01__ pòwiadom mie <WHEN_2>;

<INTENT_8_L1TC> = L1TC__ verb_pattern_01__ pòwiédz mie <WHEN_2>;

<INTENT_8_L2TC> = L2TC__ verb_pattern_01__ przëpòmni mie <WHEN_2>;

<INTENT_8_REPHRASE> = REPHRASE__ verb_pattern_01__ dôj mie znac <WHEN_2>;

##9) DONT NOTIFY ON EVENT START IN LOCATION
<INTENT_9> = <INTENT_9_L0TC> | <INTENT_9_L1TC> | <INTENT_9_L2TC> | <INTENT_9_REPHRASE>;
<INTENT_9_L0TC> = L0TC__ verb_pattern_01__ nie pòwiadamiôj mie <WHEN_2>;

<INTENT_9_L1TC> = L1TC__ verb_pattern_01__ nie mów mie <WHEN_2>;

<INTENT_9_L2TC> = L2TC__ verb_pattern_01__ nie przëpòminôj mie <WHEN_2>;

<INTENT_9_REPHRASE> = <INTENT_9_REPHRASE_1> | <INTENT_9_REPHRASE_2>;
<INTENT_9_REPHRASE_1> = REPHRASE__ verb_pattern_01__ nie wspòminôj [ò tim] <WHEN_2>;
<INTENT_9_REPHRASE_2> = REPHRASE__ verb_pattern_02__ sedz cëchò <WHEN_2>;

##10) NOTIFY WHEN EVENT START
<INTENT_10> = <INTENT_10_L0TC> | <INTENT_10_L1TC> | <INTENT_8_L2TC> | <INTENT_8_REPHRASE>;
<INTENT_10_L0TC> = L0TC__ verb_pattern_01__ pòwiédz [mie] <WHEN_3>;

<INTENT_10_L1TC> = L1TC__ verb_pattern_01__ sprôwdz [mie] <WHEN_3>;

<INTENT_10_L2TC> = L2TC__ verb_pattern_01__ ustôl <WHEN_3>;

<INTENT_10_REPHRASE> = REPHRASE__ verb_pattern_01__ <WHEN_3>;

#SLOTS
<DATE_NA> = CALENDAR.SLOT.DATE_NA;
<DATE_W> = CALENDAR.SLOT.DATE_W0;
<DATE_WE> = CALENDAR.SLOT.DATE_WE;
<EVENT_NAME> = CALENDAR.SLOT.EVENT_NAME;
<LOCATION> = CALENDAR.SLOT.LOCATION;
<ORGANIZER> = CALENDAR.SLOT.ORGANIZER;
<COUNTRY> = CALENDAR.SLOT.COUNTRY;

#LANG. COMPONENTS
<CALENDAR_APP> = kalãdôrz | planer | harmònogram;
<CALENDAR_APP_LOC> = kalãdôrzu | planerze | harmònogramie;
<CALENDAR_APP_GEN> = kalãdôrza | planera | harmònogramù;
