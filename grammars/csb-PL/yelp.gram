<INTENT_12> = <INTENT_12_L0TC> | <INTENT_12_L1TC> | <INTENT_12_L2TC> | <INTENT_12_REPHRASE>;
<INTENT_12_L0TC> = <INTENT_12_L0TC_1> | <INTENT_12_L0TC_2>;
<INTENT_12_L0TC_1> = L0TC__ verb_pattern_01__ naléz restaùracje jaczé są [jesz | wcyg] òdemkłé <AROUND> <LOCATION>;
<INTENT_12_L0TC_2> = L0TC__ verb_pattern_02__ pòkôż restaùracje jaczé są [jesz | wcyg] òdemkłé <AROUND> <LOCATION>;

<INTENT_12_L1TC> = <INTENT_12_L1TC_1> | <INTENT_12_L1TC_2>;
<INTENT_12_L1TC_1> = L1TC__ verb_pattern_01__ wëszëkôj restaùracje jaczé są [jesz | wcyg] òdemkłé  <AROUND> <LOCATION>;
<INTENT_12_L1TC_2> = L1TC__ verb_pattern_02__ wëswietl restaùracje jaczé są [jesz | wcyg] òdemkłé  <AROUND> <LOCATION>;

<INTENT_12_L2TC> = <INTENT_12_L2TC_1> | <INTENT_12_L2TC_2>;
<INTENT_12_L2TC_1> = L2TC__ verb_pattern_01__ pòwiédz [mie] gdze nalézã restaùracje jaczé są [jesz | wcyg] òdemkłé <AROUND> <LOCATION>;
<INTENT_12_L2TC_2> = L2TC__ verb_pattern_02__ pòlec [mie] restaùracje jaczé są [jesz | wcyg] òdemkłé <AROUND> <LOCATION>;

<INTENT_12_REPHRASE> = REPHRASE__ verb_pattern_01__ szëkóm òdemkłëch môlów w <LOCATION>;

#SLOTS
<LOCATION> = YELP.SLOT.LOCATION;
<QUERY> = YELP.SLOT.QUERY;
<REVIEW_COUNT> = YELP.SLOT.REVIEW_COUNT;
<RATING> = YELP.SLOT.RATING;
<CATEGORY_A> = YELP.SLOT.CATEGORY_A;
<CATEGORY_B> = YELP.SLOT.CATEGORY_B;

#LANG. COMPONENTS
<AROUND> = w pòblëżim | w òkòlim;
