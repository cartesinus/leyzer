#JSGF V1.0;
#VUI-VERSION: 0.2.0;
public <S> = Weather__ (OpenWeather__ <INTENT_1> | WeatherTomorrow__ <INTENT_2> | WeatherInLocation__ <INTENT_3> | WeatherTomorrowInLocation__ <INTENT_4> | SunriseInLocation__ <INTENT_5> | SunsetInLocation__ <INTENT_6> | SunriseAndSunsetInLocation__ <INTENT_7> | SunriseAndSunsetInLocationAndOnDate__ <INTENT_8> | MoonphaseInLocation__ <INTENT_9> | MoonphaseInLocationOnDate__ <INTENT_10>);

#INTENTS
##1) WEATHER FOR TODAY
<INTENT_1> = <INTENT_1_L0TC> | <INTENT_1_L1TC> | <INTENT_1_L2TC> | <INTENT_1_REPHRASE>;
<INTENT_1_L0TC> = <INTENT_1_L0TC_1> | <INTENT_1_L0TC_2>;
<INTENT_1_L0TC_1> = L0TC__ verb_pattern_01__ jakô (je | bãdze) [dzys] pògòda;
<INTENT_1_L0TC_2> = L0TC__ verb_pattern_02__ prognoza pògòdë [na dzys];

<INTENT_1_L1TC> = <INTENT_1_L1TC_1> | <INTENT_1_L1TC_2>;
<INTENT_1_L1TC_1> = L1TC__ verb_pattern_01__ (pogoda na dzys | prognoza pògòdë [na dzys]);
<INTENT_1_L1TC_2> = L1TC__ verb_pattern_02__ sprôwdz (prognozã pògòdë | pògòdã) [na dzys];

<INTENT_1_L2TC> = <INTENT_1_L2TC_1> | <INTENT_1_L2TC_2>;
<INTENT_1_L2TC_1> = L2TC__ verb_pattern_01__ pòwiédz [mie] czë bãdze dzys (cepło | zëmno | padało | słuńce | wiało | fùchtno);
<INTENT_1_L2TC_2> = L2TC__ verb_pattern_02__ pòdôj (prognozã pògòdë | pògòdã) [na dzys];

<INTENT_1_REPHRASE> = REPHRASE__ verb_pattern_01__ jaczi pògòdë mògã sã dzys spòdzéwac;

##2) WEATHER FOR TOMORROW
<INTENT_2> = <INTENT_2_L0TC> | <INTENT_2_L1TC> | <INTENT_2_L2TC> | <INTENT_2_REPHRASE>;
<INTENT_2_L0TC> = <INTENT_2_L0TC_1> | <INTENT_2_L0TC_2>;
<INTENT_2_L0TC_1> = L0TC__ verb_pattern_01__ (jakô bãdze witro pògòda | pògòda na witro);
<INTENT_2_L0TC_2> = L0TC__ verb_pattern_02__ prognoza pògòdë na (witro | pòstãpny dzéń);

<INTENT_2_L1TC> = L1TC__ verb_pattern_01__ sprôwdz (prognozã pògòdë | pògòdã) na (witro | pòstãpny dzéń);

<INTENT_2_L2TC> = <INTENT_2_L2TC_1> | <INTENT_2_L2TC_2>;
<INTENT_2_L2TC_1> = L2TC__ verb_pattern_01__ pòwiédz [mie] czë witro bãdze (cepło | zëmno | padało | słuńce | wiało | fùchtno);
<INTENT_2_L2TC_2> = L2TC__ verb_pattern_02__ pòdôj (prognozã pògòdë | pògòdã) na witro;

<INTENT_2_REPHRASE> = REPHRASE__ verb_pattern_01__ jaczi pògòdë mògã sã spòdzéwac witro;

##3) WEATHER IN LOCATION
<INTENT_3> = <INTENT_3_L0TC> | <INTENT_3_L1TC> | <INTENT_3_L2TC> | <INTENT_3_REPHRASE>;
<INTENT_3_L0TC> = <INTENT_3_L0TC_1> | <INTENT_3_L0TC_2>;
<INTENT_3_L0TC_1> = L0TC__ verb_pattern_01__ pòwiédz [mie] jakô je [terô | dzys | terôz] pògòda w <LOCATION>;
<INTENT_3_L0TC_2> = L0TC__ verb_pattern_02__ sprôwdz [mie] pògòdã w <LOCATION>;

<INTENT_3_L1TC> = <INTENT_3_L1TC_1> | <INTENT_3_L1TC_2>;
<INTENT_3_L1TC_1> = L1TC__ verb_pattern_01__ pòdôj [mie] [dzysdniową | terną] prognozã pògòdë (dlô | w) <LOCATION>;
<INTENT_3_L1TC_2> = L1TC__ verb_pattern_02__ wëswietl [mie] [dzysdniową | terną] prognozã pògòdë (dlô | w) <LOCATION>;

<INTENT_3_L2TC> = <INTENT_3_L2TC_1> | <INTENT_3_L2TC_2> | <INTENT_3_L2TC_3>;
<INTENT_3_L2TC_1> = L2TC__ verb_pattern_01__ chcã znac pògòdã w <LOCATION>;
<INTENT_3_L2TC_2> = L2TC__ verb_pattern_02__ chcã wiedzec jakô je pògòda w <LOCATION>;
<INTENT_3_L2TC_3> = L2TC__ verb_pattern_03__ [dzysdniowô | ternô] prognoza pògòdë (dlô | w) <LOCATION>;

<INTENT_3_REPHRASE> = REPHRASE__ verb_pattern_01__ jakô je pògòda [dzys] w <LOCATION>;

##4) WEATHER FOR TOMORROW FOR LOCATION
<INTENT_4> = <INTENT_4_L0TC> | <INTENT_4_L1TC> | <INTENT_4_L2TC> | <INTENT_4_REPHRASE>;
<INTENT_4_L0TC> = <INTENT_4_L0TC_1> | <INTENT_4_L0TC_2>;
<INTENT_4_L0TC_1> = L0TC__ verb_pattern_01__ pòwiédz [mie] jakô bãdze witro pògòda w <LOCATION>;
<INTENT_4_L0TC_2> = L0TC__ verb_pattern_02__ sprôwdz [mie] jakô bãdze witro pògòda w <LOCATION>;

<INTENT_4_L1TC> = <INTENT_4_L1TC_1> | <INTENT_4_L1TC_2>;
<INTENT_4_L1TC_1> = L1TC__ verb_pattern_01__ pòdôj [mie] witrzészą prognozã pògòdë (dlô | w) <LOCATION>;
<INTENT_4_L1TC_2> = L1TC__ verb_pattern_02__ wëswietl [mie] witrzészą prognozã pògòdë (dlô | w) <LOCATION>;

<INTENT_4_L2TC> = <INTENT_4_L2TC_1> | <INTENT_4_L2TC_2> | <INTENT_4_L2TC_3> | <INTENT_4_L2TC_4>;
<INTENT_4_L2TC_1> = L2TC__ verb_pattern_01__ chcã znac prognozã w <LOCATION>;
<INTENT_4_L2TC_2> = L2TC__ verb_pattern_02__ chcã wiedzec jakô bãdze witro pògòda w <LOCATION>;
<INTENT_4_L2TC_3> = L2TC__ verb_pattern_03__ [witrzészô] prognoza pògòdë (dlô | w) <LOCATION>;
<INTENT_4_L2TC_4> = L2TC__ verb_pattern_04__ prognoza pògòdë (dlô | w) <LOCATION> na witro;

<INTENT_4_REPHRASE> = REPHRASE__ verb_pattern_01__ jakô bãdze witro pògòda w <LOCATION>;

##5) SUNRISE
<INTENT_5> = <INTENT_5_L0TC> | <INTENT_5_L1TC> | <INTENT_5_L2TC> | <INTENT_5_REPHRASE>;
<INTENT_5_L0TC> = <INTENT_5_L0TC_1> | <INTENT_5_L0TC_2>;
<INTENT_5_L0TC_1> = L0TC__ verb_pattern_01__ pòwiédz [mie] czedë je wzénik słuńca (w | dlô) <LOCATION>;
<INTENT_5_L0TC_2> = L0TC__ verb_pattern_02__ sprôwdz [mie] czedë je wzénik słuńca (w | dlô) <LOCATION>;

<INTENT_5_L1TC> = <INTENT_5_L1TC_1> | <INTENT_5_L1TC_2>;
<INTENT_5_L1TC_1> = L1TC__ verb_pattern_01__ pòdôj [mie] czedë je wzénik słuńca (w | dlô) <LOCATION>;
<INTENT_5_L1TC_2> = L1TC__ verb_pattern_02__ wëswietl [mie] czedë je wzénik słuńca (w | dlô) <LOCATION>;

<INTENT_5_L2TC> = <INTENT_5_L2TC_1> | <INTENT_5_L2TC_2> | <INTENT_5_L2TC_3> | <INTENT_5_L2TC_4> | <INTENT_5_L2TC_5>;
<INTENT_5_L2TC_1> = L2TC__ verb_pattern_01__ (jô bë chcôł | jô bë chcała) wiedzec czedë je wzénik słuńca (w | dlô) <LOCATION>;
<INTENT_5_L2TC_2> = L2TC__ verb_pattern_02__ czë (të bë mógł | të bë mògła) [mie] pòwiédziec czedë je wzénik słuńca (w | dlô) <LOCATION>;
<INTENT_5_L2TC_3> = L2TC__ verb_pattern_03__ pòdôj [mie] czas wzénikù słuńca (w | dlô) <LOCATION>;
<INTENT_5_L2TC_4> = L2TC__ verb_pattern_04__ ò jaczi je wzénik słuńca w <LOCATION>;
<INTENT_5_L2TC_5> = L2TC__ verb_pattern_05__ (czedë | ò jaczi) wschòdzy słuńce w <LOCATION>;

<INTENT_5_REPHRASE> = REPHRASE__ verb_pattern_01__ (ò jaczi | czedë) kùńczi sã noc w <LOCATION>;

##6) SUNSET
<INTENT_6> = <INTENT_6_L0TC> | <INTENT_6_L1TC> | <INTENT_6_L2TC> | <INTENT_6_REPHRASE>;
<INTENT_6_L0TC> = <INTENT_6_L0TC_1> | <INTENT_6_L0TC_2>;
<INTENT_6_L0TC_1> = L0TC__ verb_pattern_01__ pòwiédz [mie] czedë je zôchód słuńca (w | dlô) <LOCATION>;
<INTENT_6_L0TC_2> = L0TC__ verb_pattern_02__ sprôwdz [mie] czedë je zôchód słuńca (w | dlô) <LOCATION>;

<INTENT_6_L1TC> = <INTENT_6_L1TC_1> | <INTENT_6_L1TC_2>;
<INTENT_6_L1TC_1> = L1TC__ verb_pattern_01__ pòdôj [mie] czedë je zôchód słuńca (w | dlô) <LOCATION>;
<INTENT_6_L1TC_2> = L1TC__ verb_pattern_02__ wëswietl [mie] czedë je zôchód słuńca (w | dlô) <LOCATION>;

<INTENT_6_L2TC> = <INTENT_6_L2TC_1> | <INTENT_6_L2TC_2> | <INTENT_6_L2TC_3> | <INTENT_6_L2TC_4> | <INTENT_6_L2TC_5>;
<INTENT_6_L2TC_1> = L2TC__ verb_pattern_01__ (jô bë chcôł | jô bë chcała) wiedzec czedë je zôchód słuńca (w | dlô) <LOCATION>;
<INTENT_6_L2TC_2> = L2TC__ verb_pattern_02__ czë (të bë mógł | të bë mògła) [mie] rzec czedë je zôchód słuńca (w | dlô) <LOCATION>;
<INTENT_6_L2TC_3> = L2TC__ verb_pattern_03__ pòdôj [mie] czas zachòdu słuńca (w | dlô) <LOCATION>;
<INTENT_6_L2TC_4> = L2TC__ verb_pattern_04__ (ò jaczi je zôchód słuńca w w) <LOCATION>;
<INTENT_6_L2TC_5> = L2TC__ verb_pattern_05__ (czedë | ò jaczi) zachòdzy słuńce w <LOCATION>;

<INTENT_6_REPHRASE> = REPHRASE__ verb_pattern_01__ (ò jaczi | czedë) zaczinô sã noc w <LOCATION>;

##7) SUNSET AND SUNRISE IN LOCATION
<INTENT_7> = <INTENT_7_L0TC> | <INTENT_7_L1TC> | <INTENT_7_L2TC> | <INTENT_7_REPHRASE>;
<INTENT_7_L0TC> = <INTENT_7_L0TC_1> | <INTENT_7_L0TC_2>;
<INTENT_7_L0TC_1> = L0TC__ verb_pattern_01__ pòwiédz [mie] czedë je wzénik i zôchód słuńca (w | dlô) <LOCATION>;
<INTENT_7_L0TC_2> = L0TC__ verb_pattern_02__ sprôwdz [mie] czas wzénikù i zachòdu słuńca (w | dlô) <LOCATION>;

<INTENT_7_L1TC> = L1TC__ verb_pattern_01__ pòdôj [mie] czas wzénikù i zachòdu słuńca (w | dlô) <LOCATION>;

<INTENT_7_L2TC> = L2TC__ verb_pattern_01__ (jô bë chcôł | jô bë chcała) znac czas wzénikù i zachòdu słuńca (w | dlô) <LOCATION>;

<INTENT_7_REPHRASE> = REPHRASE__ verb_pattern_01__ (ò jaczi | czedë) (dzéń zamieniô sã w noc | noc zamieniô sã w dzéń) w <LOCATION>;

##8) SUNSET AND SUNRISE IN LOCATION ON DATE
<INTENT_8> = <INTENT_8_L0TC> | <INTENT_8_L1TC> | <INTENT_8_L2TC> | <INTENT_8_REPHRASE>;
<INTENT_8_L0TC> = <INTENT_8_L0TC_1> | <INTENT_8_L0TC_2>;
<INTENT_8_L0TC_1> = L0TC__ verb_pattern_01__ pòwiédz [mie] czedë je wzénik i zôchód słuńca (w | dlô) <LOCATION> w <DATE_A>;
<INTENT_8_L0TC_2> = L0TC__ verb_pattern_02__ sprôwdz [mie] czas wzénikù i zachòdu słuńca (w | dlô) <LOCATION> w <DATE_A>;

<INTENT_8_L1TC> = L1TC__ verb_pattern_01__ pòdôj [mie] czas wzénikù i zachòdu słuńca (w | dlô) <LOCATION> w <DATE_A>;

<INTENT_8_L2TC> = L2TC__ verb_pattern_01__ (jô bë chcôł | jô bë chcała) znac czas wzénikù i zachòdu słuńca (w | dlô) <LOCATION> w <DATE_A>;

<INTENT_8_REPHRASE> = REPHRASE__ verb_pattern_01__ (ò jaczi | czedë) (dzéń zamieniô sã w noc | noc zamieniô sã w dzéń) w <LOCATION> w <DATE_A>;

##9) MOON PHASE IN LOCATION
<INTENT_9> = <INTENT_9_L0TC> | <INTENT_9_L1TC> | <INTENT_9_L2TC> | <INTENT_9_REPHRASE>;
<INTENT_9_L0TC> = L0TC__ verb_pattern_01__ sprôwdz fazã miesądza w <LOCATION>;

<INTENT_9_L1TC> = L1TC__ verb_pattern_01__ [jakô je] faza miesądza w <LOCATION>;

<INTENT_9_L2TC> = L2TC__ verb_pattern_01__ czë miesądz je (w pełni | w nowiu) w <LOCATION>;

<INTENT_9_REPHRASE> = REPHRASE__ verb_pattern_01__ jak wygląda miesądz w <LOCATION>;

##10) MOON PHASE IN LOCATION FOR DATE
<INTENT_10> = <INTENT_10_L0TC> | <INTENT_10_L1TC> | <INTENT_10_L2TC> | <INTENT_10_REPHRASE>;
<INTENT_10_L0TC> = L0TC__ verb_pattern_01__ sprôwdz fazã miesądza w <LOCATION> w <DATE_A>;

<INTENT_10_L1TC> = L1TC__ verb_pattern_01__ [jakô (je | bãdze)] faza miesądza w <LOCATION> w <DATE_A>;

<INTENT_10_L2TC> = L2TC__ verb_pattern_01__ czë miesądz bãdze (w pełni | w nowiu) w <DATE_A> w <LOCATION>;

<INTENT_10_REPHRASE> = REPHRASE__ verb_pattern_01__ jak bãdze wëzdrzôł miesądz w <LOCATION> w <DATE_A>;

#SLOTS
<LOCATION> = WEATHER.SLOT.LOCATION;
<TEMPERATURE> = WEATHER.SLOT.TEMPERATURE;
<HUMIDITY> = WEATHER.SLOT.HUMIDITY;
<DATE> = WEATHER.SLOT.DATE;
<DATE_A> = WEATHER.SLOT.DATE_A;
<STATUS> = WEATHER.SLOT.STATUS;
