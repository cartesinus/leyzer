<INTENT_1_L0TC_1> = L0TC__ verb_pattern_01__ òdemkni (facebook | facebooka | fejsa);
<INTENT_1_L0TC_2> = L0TC__ verb_pattern_02__ ùruchòm (facebook | facebooka | fejsa);

<INTENT_1_L1TC> = <INTENT_1_L1TC_1> | <INTENT_1_L1TC_2>;
<INTENT_1_L1TC_1> = L1TC__ verb_pattern_01__ stwórz [nowi] pòst na (facebooka | facebook | fejsa);
<INTENT_1_L1TC_2> = L1TC__ verb_pattern_02__ zaktualizuj [mój] status na (facebooku | fejsu);

<INTENT_1_L2TC> = <INTENT_1_L2TC_1> | <INTENT_1_L2TC_2> | <INTENT_1_L2TC_3> | <INTENT_1_L2TC_4> | <INTENT_1_L2TC_5>;
<INTENT_1_L2TC_1> = L2TC__ verb_pattern_01__ wësli [cos] na (facebooka | fejsu | facebooku);
<INTENT_1_L2TC_2> = L2TC__ verb_pattern_02__ uploaduj [cos] na (facebooka | fejsu | facebooku);
<INTENT_1_L2TC_3> = L2TC__ verb_pattern_03__ dodôj [cos] na (facebooka | fejsu | facebooku);
<INTENT_1_L2TC_4> = L2TC__ verb_pattern_04__ ùmiesc [cos] na (facebooka | fejsu | facebooku);
<INTENT_1_L2TC_5> = L2TC__ verb_pattern_05__ napisz [cos] na (facebooka | fejsu | facebooku);

<INTENT_1_REPHRASE> = REPHRASE__ verb_pattern_01__ niech wszëtcë wiedzą co prawie robiã;

##2) CREATE pòst
<INTENT_2> = <INTENT_2_L0TC> | <INTENT_2_L1TC> | <INTENT_2_L2TC> | <INTENT_2_REPHRASE>;

