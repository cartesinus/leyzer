<INTENT_2_L1TC_2> = L1TC__ verb_pattern_02__ dodôj ([status] <STATUS> na (facebooku | fejsu) | [status] na (facebooku | fejsu) [ò tim że] <STATUS> | na [mòji] tôblëcë na (facebooku | fejsu) <STATUS> | <STATUS> na [mòji] tôblëcë na (facebooku | fejsu));

<INTENT_2_L2TC> = <INTENT_2_L2TC_1> | <INTENT_2_L2TC_2> | <INTENT_2_L2TC_3> | <INTENT_2_L2TC_4> | <INTENT_2_L2TC_5> | <INTENT_2_L2TC_6> | <INTENT_2_L2TC_7> | <INTENT_2_L2TC_8> | <INTENT_2_L2TC_9>;
<INTENT_2_L2TC_1> = L2TC__ verb_pattern_01__ stwórz ([status] <STATUS> na (facebooku | fejsu) | [status] na (facebooku | fejsu) [ò tim że] <STATUS> | na [mòji] tôblëcë na (facebooku | fejsu) <STATUS> | <STATUS> na [mòji] tôblëcë na (facebooku | fejsu));
<INTENT_2_L2TC_2> = L2TC__ verb_pattern_02__ zaktualizuj [mòjégò] (facebooka | fejsa) ò [status [mówiący]] <STATUS>;
<INTENT_2_L2TC_3> = L2TC__ verb_pattern_03__ updateuj [mòjégò] (facebooka | fejsa) ò [status [mówiący]] <STATUS>;
<INTENT_2_L2TC_4> = L2TC__ verb_pattern_04__ infòrmùj [mòjégò] (facebooka | fejsa) ò [status [mówiący]] <STATUS>;
<INTENT_2_L2TC_5> = L2TC__ verb_pattern_05__ wësli [nowi] pòst (że | jaczi mówi [że] | ò tresce) <STATUS> [na facebooku | na fejsu];
<INTENT_2_L2TC_6> = L2TC__ verb_pattern_06__ uploaduj [nowi] pòst (że | jaczi mówi [że] | ò tresce) <STATUS> [na facebooku | na fejsu];
<INTENT_2_L2TC_7> = L2TC__ verb_pattern_07__ dodôj [nowi] pòst (że | jaczi mówi [że] | ò tresce) <STATUS> [na facebooku | na fejsu];
<INTENT_2_L2TC_8> = L2TC__ verb_pattern_08__ ùmiesc [nowi] pòst (że | jaczi mówi [że] | ò tresce) <STATUS> [na facebooku | na fejsu];
<INTENT_2_L2TC_9> = L2TC__ verb_pattern_09__ napisz [nowi] pòst (że | jaczi mówi [że] | ò tresce) <STATUS> [na facebooku | na fejsu];

<INTENT_2_REPHRASE> = REPHRASE__ verb_pattern_01__ pòwiédz ([mòji] rodzënie | [mòjim] drëchóm | [mòjim] znajomim) ò <STATUS>;

