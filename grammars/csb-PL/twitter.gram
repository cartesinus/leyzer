#JSGF V1.0;
#VUI-VERSION: 0.2.0;
public <S> = Twitter__ (OpenTwitter__ <INTENT_1> | FollowUser__ <INTENT_2> | UnfollowUser__ <INTENT_3> | SendTwitterMessage__ <INTENT_4> | SendMessageToUser__ <INTENT_5> | ShowTwittsWithHashtag__ <INTENT_6>);

#INTENTS
##1) SHOW USER TWEETS
<INTENT_1> = <INTENT_1_L0TC> | <INTENT_1_L1TC> | <INTENT_1_L2TC> | <INTENT_1_REPHRASE>;
<INTENT_1_L0TC> = L0TC__ verb_pattern_01__ pòkôż [mòje] (twittë | pòstë na twitterze | twittë jaczé jem napisôł);

<INTENT_1_L1TC> = L1TC__ verb_pattern_01__ wëswietl [mòje] (twittë | pòstë na twitterze | twittë jaczé jem napisôł);

<INTENT_1_L2TC> = L2TC__ verb_pattern_01__ (zobacz | chcã òbaczëc) [mòje] (twittë | pòstë na twitterze | twittë jaczé jem napisôł);

<INTENT_1_REPHRASE> = REPHRASE__ verb_pattern_01__ òdemkni twittera i pòkôż (to co jem napisôł | [mòją] historiã);

##2) FOLLOW GIVEN USER
<INTENT_2> = <INTENT_2_L0TC> | <INTENT_2_L1TC> | <INTENT_2_L2TC> | <INTENT_2_REPHRASE>;
<INTENT_2_L0TC> = L0TC__ verb_pattern_01__ òbserwùj [aktiwnosc] <USERNAME> na twitterze;

<INTENT_2_L1TC> = <INTENT_2_L1TC_1> | <INTENT_2_L1TC_2> | <INTENT_2_L1TC_3> | <INTENT_2_L1TC_4>;
<INTENT_2_L1TC_1> = L1TC__ verb_pattern_01__ zaczni sledzëc [aktiwnosc] <USERNAME> na twitterze;
<INTENT_2_L1TC_2> = L1TC__ verb_pattern_02__ zaczni òbserwiwac [aktiwnosc] <USERNAME> na twitterze;
<INTENT_2_L1TC_3> = L1TC__ verb_pattern_03__ zaczni sledzëc co <USERNAME> (pisze | pùblikùje) na twitterze;
<INTENT_2_L1TC_4> = L1TC__ verb_pattern_04__ zaczni òbserwiwac co <USERNAME> (pisze | pùblikùje) na twitterze;

<INTENT_2_L2TC> = <INTENT_2_L2TC_1> | <INTENT_2_L2TC_2> | <INTENT_2_L2TC_3>;
<INTENT_2_L2TC_1> = L2TC__ verb_pattern_01__ chcã bëc na bieżąco z tim co pùblikùje <USERNAME> na twitterze;
<INTENT_2_L2TC_2> = L2TC__ verb_pattern_02__ chcã bëc na bieżąco z tim co pisze <USERNAME> na twitterze;
<INTENT_2_L2TC_3> = L2TC__ verb_pattern_03__ òstóń followersã <USERNAME> na twitterze;

<INTENT_2_REPHRASE> = REPHRASE__ verb_pattern_01__ szpiegùj <USERNAME>;

##3) UNFOLLOW GIVEN USER
<INTENT_3> = <INTENT_3_L0TC> | <INTENT_3_L1TC> | <INTENT_3_L2TC> | <INTENT_3_REPHRASE>;
<INTENT_3_L0TC> = L0TC__ verb_pattern_01__ przestóń òbserwiwac [aktiwnosc] <USERNAME> na twitterze;

<INTENT_3_L1TC> = <INTENT_3_L1TC_1> | <INTENT_3_L1TC_2>;
<INTENT_3_L1TC_1> = L1TC__ verb_pattern_01__ przestóń sledzëc [aktiwnosc] <USERNAME> na twitterze;
<INTENT_3_L1TC_2> = L1TC__ verb_pattern_02__ przestóń followòwac <USERNAME> na twitterze;

<INTENT_3_L2TC> = <INTENT_3_L2TC_1> | <INTENT_3_L2TC_2> | <INTENT_3_L2TC_3>;
<INTENT_3_L2TC_1> = L2TC__ verb_pattern_01__ nie chcã [ju] òbserwiwac co <USERNAME> (pisze | pùblikùje) na twitterze;
<INTENT_3_L2TC_2> = L2TC__ verb_pattern_02__ nie chcã [ju] sledzëc co <USERNAME> (pisze | pùblikùje) na twitterze;
<INTENT_3_L2TC_3> = L2TC__ verb_pattern_03__ nie chcã [ju] wiedzec co <USERNAME> (pisze | pùblikùje) na twitterze;

<INTENT_3_REPHRASE> = REPHRASE__ verb_pattern_01__ przestóń szpiegòwac <USERNAME>;

##4) SEND MESSAGE TO USER
<INTENT_4> = <INTENT_4_L0TC> | <INTENT_4_L1TC> | <INTENT_4_L2TC> | <INTENT_4_REPHRASE>;
<INTENT_4_L0TC> = <INTENT_4_L0TC_1> | <INTENT_4_L0TC_2>;
<INTENT_4_L0TC_1> = L0TC__ verb_pattern_01__ wësli (wiadło | pw | priwatné wiadło) na (twitterze | twittera) [ò tresce] <MESSAGE>;
<INTENT_4_L0TC_2> = L0TC__ verb_pattern_02__ napisz (wiadło | pw | priwatné wiadło) na (twitterze | twittera) [ò tresce] <MESSAGE>;

<INTENT_4_L1TC> = <INTENT_4_L1TC_1> | <INTENT_4_L1TC_2>;
<INTENT_4_L1TC_1> = L1TC__ verb_pattern_01__ wësli na (twitterze | twittera) (wiadło | pw | priwatné wiadło) [ò tresce] <MESSAGE>;
<INTENT_4_L1TC_2> = L1TC__ verb_pattern_02__ napisz na (twitterze | twittera) (wiadło | pw | priwatné wiadło) [ò tresce] <MESSAGE>;

<INTENT_4_L2TC> = <INTENT_4_L2TC_1> | <INTENT_4_L2TC_2> | <INTENT_4_L2TC_3> | <INTENT_4_L2TC_4> | <INTENT_4_L2TC_5> | <INTENT_4_L2TC_6>;
<INTENT_4_L2TC_1> = L2TC__ verb_pattern_01__ przesli (wiadło | pw | priwatné wiadło) na (twitterze | twittera) [ò tresce] <MESSAGE>;
<INTENT_4_L2TC_2> = L2TC__ verb_pattern_02__ przesli na (twitterze | twittera) (wiadło | pw | priwatné wiadło) [ò tresce] <MESSAGE>;
<INTENT_4_L2TC_3> = L2TC__ verb_pattern_03__ ùtwórz na (twitterze | twittera) (wiadło | pw | priwatné wiadło) [ò tresce] <MESSAGE>;
<INTENT_4_L2TC_4> = L2TC__ verb_pattern_04__ ùtwórz (wiadło | pw | priwatné wiadło) na (twitterze | twittera) [ò tresce] <MESSAGE>;
<INTENT_4_L2TC_5> = L2TC__ verb_pattern_05__ stwórz (wiadło | pw | priwatné wiadło) na (twitterze | twittera) [ò tresce] <MESSAGE>;
<INTENT_4_L2TC_6> = L2TC__ verb_pattern_06__ czirkni (wiadło | pw | priwatné wiadło) [ò tresce] <MESSAGE>;

<INTENT_4_REPHRASE> = REPHRASE__ verb_pattern_01__ pòdzél sã <MESSAGE> z lëdzama na twitterze;

##5) SEND MESSAGE TO USER
<INTENT_5> = <INTENT_5_L0TC> | <INTENT_5_L1TC> | <INTENT_5_L2TC> | <INTENT_5_REPHRASE>;
<INTENT_5_L0TC> = <INTENT_5_L0TC_1> | <INTENT_5_L0TC_2>;
<INTENT_5_L0TC_1> = L0TC__ verb_pattern_01__ wësli [wiadło] <MESSAGE> do <USERNAME> na twitterze;
<INTENT_5_L0TC_2> = L0TC__ verb_pattern_02__ napisz [wiadło] <MESSAGE> do <USERNAME> na twitterze;

<INTENT_5_L1TC> = <INTENT_5_L1TC_1> | <INTENT_5_L1TC_2>;
<INTENT_5_L1TC_1> = L1TC__ verb_pattern_01__ napisz (na twittera | twitterze) [wiadło] <MESSAGE> do <USERNAME>;
<INTENT_5_L1TC_2> = L1TC__ verb_pattern_02__ przesli [wiadło] <MESSAGE> do <USERNAME> na twitterze;

<INTENT_5_L2TC> = <INTENT_5_L2TC_1> | <INTENT_5_L2TC_2> | <INTENT_5_L2TC_3> | <INTENT_5_L2TC_4> | <INTENT_5_L2TC_5> | <INTENT_5_L2TC_6> | <INTENT_5_L2TC_7> | <INTENT_5_L2TC_8> | <INTENT_5_L2TC_9> | <INTENT_5_L2TC_10> | <INTENT_5_L2TC_11> | <INTENT_5_L2TC_12> | <INTENT_5_L2TC_13>;
<INTENT_5_L2TC_1> = L2TC__ verb_pattern_01__ na twitterze wësli [wiadło | pw | priwatné wiadło] do <USERNAME> ò tresce <MESSAGE>;
<INTENT_5_L2TC_2> = L2TC__ verb_pattern_02__ na twitterze napisz [wiadło | pw | priwatné wiadło] do <USERNAME> ò tresce <MESSAGE>;
<INTENT_5_L2TC_3> = L2TC__ verb_pattern_03__ na twitterze ùtwórz [wiadło | pw | priwatné wiadło] do <USERNAME> ò tresce <MESSAGE>;
<INTENT_5_L2TC_4> = L2TC__ verb_pattern_04__ na twitterze przesli [wiadło | pw | priwatné wiadło] do <USERNAME> ò tresce <MESSAGE>;
<INTENT_5_L2TC_5> = L2TC__ verb_pattern_05__ na twitterze stwórz [wiadło | pw | priwatné wiadło] do <USERNAME> ò tresce <MESSAGE>;
<INTENT_5_L2TC_6> = L2TC__ verb_pattern_06__ na twitterze wësli (wiadło | pw | priwatné wiadło) <MESSAGE> do <USERNAME>;
<INTENT_5_L2TC_7> = L2TC__ verb_pattern_07__ na twitterze napisz (wiadło | pw | priwatné wiadło) <MESSAGE> do <USERNAME>;
<INTENT_5_L2TC_8> = L2TC__ verb_pattern_08__ na twitterze ùtwórz (wiadło | pw | priwatné wiadło) <MESSAGE> do <USERNAME>;
<INTENT_5_L2TC_9> = L2TC__ verb_pattern_09__ na twitterze przesli (wiadło | pw | priwatné wiadło) <MESSAGE> do <USERNAME>;
<INTENT_5_L2TC_10> = L2TC__ verb_pattern_10__ na twitterze stwórz (wiadło | pw | priwatné wiadło) <MESSAGE> do <USERNAME>;
<INTENT_5_L2TC_11> = L2TC__ verb_pattern_11__ czirkni [wiadło | pw | priwatné wiadło] do <USERNAME> ò tresce <MESSAGE>;
<INTENT_5_L2TC_12> = L2TC__ verb_pattern_12__ czirkni <MESSAGE> do <USERNAME>;
<INTENT_5_L2TC_13> = L2TC__ verb_pattern_13__ nadôj [wiadło] <MESSAGE> do <USERNAME> na twitterze;

<INTENT_5_REPHRASE> = REPHRASE__ verb_pattern_01__ pòdzél sã z <USERNAME> twittem <MESSAGE>;

##6) FIND TWEETS WITH HASHTAGS
<INTENT_6> = <INTENT_6_L0TC> | <INTENT_6_L1TC> | <INTENT_6_L2TC> | <INTENT_6_REPHRASE>;
<INTENT_6_L0TC> = <INTENT_6_L0TC_1> | <INTENT_6_L0TC_2>;
<INTENT_6_L0TC_1> = L0TC__ verb_pattern_01__ wëszëkôj [mie] twittë (z hashtagã | ò hashtagù) <HASHTAG>;
<INTENT_6_L0TC_2> = L0TC__ verb_pattern_02__ naléz [mie] twittë (z hashtagã | ò hashtagù) <HASHTAG>;

<INTENT_6_L1TC> = <INTENT_6_L1TC_1> | <INTENT_6_L1TC_2> | <INTENT_6_L1TC_3>;
<INTENT_6_L1TC_1> = L1TC__ verb_pattern_01__ òdnaléz [mie] twittë (z hashtagã | ò hashtagù) <HASHTAG>;
<INTENT_6_L1TC_2> = L1TC__ verb_pattern_02__ pòkôż [mie] twittë (z hashtagã | ò hashtagù) <HASHTAG>;
<INTENT_6_L1TC_3> = L1TC__ verb_pattern_03__ wëswietl [mie] twittë (z hashtagã | ò hashtagù) <HASHTAG>;

<INTENT_6_L2TC> = L2TC__ verb_pattern_01__ twittë (z hashtagã | ò hashtagù) <HASHTAG>;

<INTENT_6_REPHRASE> = REPHRASE__ verb_pattern_01__ co je napisóné na twitterze ò <HASHTAG>;

#SLOTS
<USERNAME> = TWITTER.SLOT.USERNAME;
<MESSAGE> = TWITTER.SLOT.MESSAGE;
<HASHTAG> = TWITTER.SLOT.HASHTAG;
