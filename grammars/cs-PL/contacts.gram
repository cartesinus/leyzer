#JSGF V1.0;
#VUI-VERSION: 0.2.0;
public <S> = Contacts__  (OpenContacts__ <INTENT_1> | OpenMyContact__ <INTENT_2> | ShowContactWithEmail__ <INTENT_3> | ShowContactWithNumber__ <INTENT_4> | ShowContactWithName__ <INTENT_5> | ShowContactWithNumberAndWithEmail__ <INTENT_6> | CreateContactWithNameAndWithNumberAndWithType__ <INTENT_7> | EditContactWithName__ <INTENT_8> | EditContactWithNumber__ <INTENT_9> | EditNumberInContactWithName__ <INTENT_10> | EditNumberInContactWithNameToNumberAndToType__ <INTENT_11>);

#INTENTS
##1) OPEN CONTACTS
<INTENT_1> = <INTENT_1_L0TC> | <INTENT_1_L1TC> | <INTENT_1_L2TC> | <INTENT_1_REPHRASE>;
<INTENT_1_L0TC> = L0TC__ verb_pattern_01__ pòkôż [mie] ([mòje] kòntaktë | [mòją] lëstã kòntaktów);

<INTENT_1_L1TC> = <INTENT_1_L1TC_1> | <INTENT_1_L1TC_2>;
<INTENT_1_L1TC_1> = L1TC__ verb_pattern_01__ wëswietl [mie] ([mòje] kòntaktë | [mòją] lëstã kòntaktów);
<INTENT_1_L1TC_2> = L1TC__ verb_pattern_02__ òdemkni ([mòje] kòntaktë | [mòją] lëstã kòntaktów);

<INTENT_1_L2TC> = L2TC__ verb_pattern_01__ sprôwdz ([mòje] kòntaktë | [mòją] lëstã kòntaktów);

<INTENT_1_REPHRASE> = REPHRASE__ verb_pattern_01__ pòkôż [mi | tã] lëstã (z numerama telefònów | gdze (jem zapisôł | jem zapisała) (numerë telefònów | òsobë | drëchów));

##2) SHOW MY INFO
<INTENT_2> = <INTENT_2_L0TC> | <INTENT_2_L1TC> | <INTENT_2_L2TC> | <INTENT_2_REPHRASE>;
<INTENT_2_L0TC> = L0TC__ verb_pattern_01__ pòkôż [mie] (mòje infòrmacje w kòntaktach | mój wpis w kòntaktach | mòją wizytówkã);

<INTENT_2_L1TC> = <INTENT_2_L1TC_1> | <INTENT_2_L1TC_2>;
<INTENT_2_L1TC_1> = L1TC__ verb_pattern_01__ wëswietl [mie] (mòje infòrmacje w kòntaktach | mój wpis w kòntaktach | mòją wizytówkã);
<INTENT_2_L1TC_2> = L1TC__ verb_pattern_02__ òdemkni (mòje infòrmacje w kòntaktach | mój wpis w kòntaktach | mòją wizytówkã);

<INTENT_2_L2TC> = L2TC__ verb_pattern_01__ sprôwdz (mòje infòrmacje w kòntaktach | mój wpis w kòntaktach | mòją wizytówkã);

<INTENT_2_REPHRASE> = REPHRASE__ (<INTENT_2_REPHRASE_1> | <INTENT_2_REPHRASE_2>);
<INTENT_2_REPHRASE_1> = verb_pattern_01__ pòkôż mój numer [telefònu];
<INTENT_2_REPHRASE_2> = verb_pattern_01__ przëbôcz mi (jaczi móm | mój) numer telefònu;

##3) SHOW CONTACT WITH EMAIL
<INTENT_3> = <INTENT_3_L0TC> | <INTENT_3_L1TC> | <INTENT_3_L2TC> | <INTENT_3_REPHRASE>;
<INTENT_3_L0TC> = (<INTENT_3_L0TC_1> | <INTENT_3_L0TC_2>) <INTENT_3_END>;
<INTENT_3_L0TC_1> = L0TC__ verb_pattern_01__ pòkôż [mie];
<INTENT_3_L0TC_2> = L0TC__ verb_pattern_02__ wëszëkôj [mie];

<INTENT_3_L1TC> = (<INTENT_3_L1TC_1> | <INTENT_3_L1TC_2>) <INTENT_3_END>;
<INTENT_3_L1TC_1> = L1TC__ verb_pattern_01__ wëswietl [mie];
<INTENT_3_L1TC_2> = L1TC__ verb_pattern_02__ òdemkni;

<INTENT_3_L2TC> = L2TC__ verb_pattern_01__ sprôwdz <INTENT_3_END>;
<INTENT_3_END> = [mój] kòntakt (z adresã email | ò adresu (email | mailowim) | z emailã | z mailã) <EMAIL>;

<INTENT_3_REPHRASE> = REPHRASE__ (<INTENT_3_REPHRASE_1> | <INTENT_3_REPHRASE_2> | <INTENT_3_REPHRASE_3>);
<INTENT_3_REPHRASE_1> = verb_pattern_01__ [pòkôż] (czij je | do kògò nôleżi) email <EMAIL>;
<INTENT_3_REPHRASE_2> = verb_pattern_02__ pòwiédz (czij je | do kògò nôleżi) email <EMAIL>;
<INTENT_3_REPHRASE_3> = verb_pattern_03__ nie wiém (czij je | do kògò nôleżi) email <EMAIL>;

##4) SHOW CONTACT WITH NUMBER
<INTENT_4> = <INTENT_4_L0TC> | <INTENT_4_L1TC> | <INTENT_4_L2TC> | <INTENT_4_REPHRASE>;
<INTENT_4_L0TC> = (<INTENT_4_L0TC_1> | <INTENT_4_L0TC_2>) <INTENT_4_END>;
<INTENT_4_L0TC_1> = L0TC__ verb_pattern_01__ pòkôż [mie];
<INTENT_4_L0TC_2> = L0TC__ verb_pattern_02__ wëszëkôj [mie];

<INTENT_4_L1TC> = (<INTENT_4_L1TC_1> | <INTENT_4_L1TC_2>) <INTENT_4_END>;
<INTENT_4_L1TC_1> = L1TC__ verb_pattern_01__ wëswietl [mie];
<INTENT_4_L1TC_2> = L1TC__ verb_pattern_02__ òdemkni;

<INTENT_4_L2TC> = L2TC__ verb_pattern_01__ sprôwdz <INTENT_4_END>;
<INTENT_4_END> = [mój] kòntakt (z numerã [telefònu] | ò numerze [telefònu]) <PHONE_NUMBER>;

<INTENT_4_REPHRASE> = REPHRASE__ (<INTENT_4_REPHRASE_1> | <INTENT_4_REPHRASE_2> | <INTENT_4_REPHRASE_3>);
<INTENT_4_REPHRASE_1> = verb_pattern_01__ [pòkôż] (czij je | do kògò nôleżi) numer [telefònu] <PHONE_NUMBER>;
<INTENT_4_REPHRASE_2> = verb_pattern_02__ pòwiédz (czij je | do kògò nôleżi) numer [telefònu] <PHONE_NUMBER>;
<INTENT_4_REPHRASE_3> = verb_pattern_03__ nie wiém (czij je | do kògò nôleżi) numer [telfonu] <PHONE_NUMBER>;

##5) SHOW CONTACT WITH NAME
<INTENT_5> = <INTENT_5_L0TC> | <INTENT_5_L1TC> | <INTENT_5_L2TC> | <INTENT_5_REPHRASE>;
<INTENT_5_L0TC> = (<INTENT_5_L0TC_1> | <INTENT_5_L0TC_2>) <INTENT_5_END>;
<INTENT_5_L0TC_1> = L0TC__ verb_pattern_01__ pòkôż [mie];
<INTENT_5_L0TC_2> = L0TC__ verb_pattern_02__ wëszëkôj [mie];

<INTENT_5_L1TC> = (<INTENT_5_L1TC_1> | <INTENT_5_L1TC_2>) <INTENT_5_END>;
<INTENT_5_L1TC_1> = L1TC__ verb_pattern_01__ wëswietl [mie];
<INTENT_5_L1TC_2> = L1TC__ verb_pattern_02__ òdemkni;

<INTENT_5_L2TC> = L2TC__ verb_pattern_01__ sprôwdz <INTENT_5_END>;
<INTENT_5_END> = ((infòrmacje | dané) kòntaktu | [mój] kòntakt (ò nazwie | nazéwający sã)) <NAME>;

<INTENT_5_REPHRASE> = REPHRASE__ (<INTENT_5_REPHRASE_1> | <INTENT_5_REPHRASE_2>);
<INTENT_5_REPHRASE_1> = verb_pattern_01__ przëbôcz mi (dané | infòrmacje) dlô [kòntaktu] <NAME>;
<INTENT_5_REPHRASE_2> = verb_pattern_02__ jaczi numer (telefònu | email) (mô | miôł) <NAME>;

##6) SHOW CONTACT WITH NUMBER AND EMAIL
<INTENT_6> = <INTENT_6_L0TC> | <INTENT_6_L1TC> | <INTENT_6_L2TC> | <INTENT_6_REPHRASE>;
<INTENT_6_L0TC> = <INTENT_6_L0TC_1> | <INTENT_6_L0TC_2>;
<INTENT_6_L0TC_1> = L0TC__ verb_pattern_01__ naléz [mój] kòntakt (z numerã [telefònu] | ò numerze [telefònu]) <PHONE_NUMBER> (oraz | i) (z adresã email | ò adresu (email | mailowim) | z emailã | z mailã) <EMAIL>;
<INTENT_6_L0TC_2> = L0TC__ verb_pattern_02__ wëszëkôj [mój] kòntakt (z numerã [telefònu] | ò numerze [telefònu]) <PHONE_NUMBER> (oraz | i) (z adresã email | ò adresu (email | mailowim) | z emailã | z mailã) <EMAIL>;

<INTENT_6_L1TC> = <INTENT_6_L1TC_1> | <INTENT_6_L1TC_2> | <INTENT_6_L1TC_3>;
<INTENT_6_L1TC_1> = L1TC__ verb_pattern_01__ pòkôż [mój] kòntakt (z numerã [telefònu] | ò numerze [telefònu]) <PHONE_NUMBER> (oraz | i) (z adresã email | ò adresu (email | mailowim) | z emailã | z mailã) <EMAIL>;
<INTENT_6_L1TC_2> = L1TC__ verb_pattern_02__ wëswietl [mój] kòntakt (z numerã [telefònu] | ò numerze [telefònu]) <PHONE_NUMBER> (oraz | i) (z adresã email | ò adresu (email | mailowim) | z emailã | z mailã) <EMAIL>;
<INTENT_6_L1TC_3> = L1TC__ verb_pattern_03__ òdemkni [mój] kòntakt (z numerã [telefònu] | ò numerze [telefònu]) <PHONE_NUMBER> (oraz | i) (z adresã email | ò adresu (email | mailowim) | z emailã | z mailã) <EMAIL>;

<INTENT_6_L2TC> = <INTENT_6_L2TC_1> | <INTENT_6_L2TC_2>;
<INTENT_6_L2TC_1> = L2TC__ verb_pattern_01__ naléz chto mô numer [telefònu] <PHONE_NUMBER> i adres [email | mailowi] <EMAIL>;
<INTENT_6_L2TC_2> = L2TC__ verb_pattern_02__ wëszëkôj chto mô numer [telefònu] <PHONE_NUMBER> i adres [email | mailowi] <EMAIL>;
<INTENT_6_REPHRASE> = REPHRASE__ verb_pattern_01__ do kògò nôleżi <PHONE_NUMBER> (lub | abò) <EMAIL>;

##7) CREATE CONTACT WITH NAME AND NUMBER
<INTENT_7> = <INTENT_7_L0TC> | <INTENT_7_L1TC> | <INTENT_7_L2TC> | <INTENT_7_REPHRASE>;
<INTENT_7_L0TC> = <INTENT_7_L0TC_1> | <INTENT_7_L0TC_2>;
<INTENT_7_L0TC_1> = L0TC__ verb_pattern_01__ stwórz [nowi] kòntakt (ò nazwie | nazéwając gò) <NAME> (z numerã [telefònu] | ò numerze [telefònu]) <PHONE_NUMBER> [jakò [typ] <PHONE_TYPE>];
<INTENT_7_L0TC_2> = L0TC__ verb_pattern_02__ ùtwórz [nowi] kòntakt (ò nazwie | nazéwając gò) <NAME> (z numerã [telefònu] | ò numerze [telefònu]) <PHONE_NUMBER> [jakò [typ] <PHONE_TYPE>];

<INTENT_7_L1TC> = L1TC__ verb_pattern_01__ dodôj do kòntaktów <NAME> (z numerã [telefònu] | ò numerze [telefònu]) <PHONE_NUMBER> [jakò [typ] <PHONE_TYPE>];

<INTENT_7_L2TC> = L2TC__ verb_pattern_01__ zrób [nowi] kòntakt (ò nazwie | nazéwając gò) <NAME> (z numerã [telefònu] | ò numerze [telefònu]) <PHONE_NUMBER> [jakò [typ] <PHONE_TYPE>];
<INTENT_7_REPHRASE> = REPHRASE__ verb_pattern_01__ zapisz nowi kòntakt ò nazwie <NAME> i z numerã <PHONE_NUMBER>;

##8) EDIT CONTACT WITH NAME
<INTENT_8> = <INTENT_8_L0TC> | <INTENT_8_L1TC> | <INTENT_8_L2TC> | <INTENT_8_REPHRASE>;
<INTENT_8_L0TC> = L0TC__ verb_pattern_01__ edituj [mój] kòntakt [ò nazwie] <NAME>;

<INTENT_8_L1TC> = <INTENT_8_L1TC_1> | <INTENT_8_L1TC_2> | <INTENT_8_L1TC_3>;
<INTENT_8_L1TC_1> = L1TC__ verb_pattern_01__ zmień [mój] kòntakt [ò nazwie] <NAME>;
<INTENT_8_L1TC_2> = L1TC__ verb_pattern_02__ aktualizuj [mój] kòntakt [ò nazwie] <NAME>;
