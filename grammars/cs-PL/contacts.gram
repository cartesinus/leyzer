<INTENT_8_L2TC> = L2TC__ verb_pattern_01__ òdemkni [mój] kòntakt <NAME> (do edycji | żeby go editowac);

<INTENT_8_REPHRASE> = REPHRASE__ (<INTENT_8_REPHRASE_1> | <INTENT_8_REPHRASE_2>);
<INTENT_8_REPHRASE_1> = verb_pattern_01__ zapisz nowé dané dlô <NAME>;
<INTENT_8_REPHRASE_2> = verb_pattern_02__ ùstôw nowé dané dlô <NAME>;

##9) EDIT CONTACT WITH NUMBER
<INTENT_9> = <INTENT_9_L0TC> | <INTENT_9_L1TC> | <INTENT_9_L2TC> | <INTENT_9_REPHRASE>;
<INTENT_9_L0TC> = L0TC__ verb_pattern_01__ zmień nazwã [mòjégò] kòntaktu (z numerã [telefònu] | ò numerze [telefònu]) <PHONE_NUMBER>;

<INTENT_9_L1TC> = <INTENT_9_L1TC_1> | <INTENT_9_L1TC_2> | <INTENT_9_L1TC_3>;
<INTENT_9_L1TC_1> = L1TC__ verb_pattern_01__ aktualizuj nazwã [mòjégò] kòntaktu (z numerã [telefònu] | ò numerze [telefònu]) <PHONE_NUMBER>;
<INTENT_9_L1TC_2> = L1TC__ verb_pattern_02__ edituj nazwã [mòjégò] kòntaktu (z numerã [telefònu] | ò numerze [telefònu]) <PHONE_NUMBER>;
<INTENT_9_L1TC_3> = L1TC__ verb_pattern_03__ pòprôw nazwã [mòjégò] kòntaktu (z numerã [telefònu] | ò numerze [telefònu]) <PHONE_NUMBER>;

