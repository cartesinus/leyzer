##11) EDIT SPECIFIC NUMBER FOR NAME
<INTENT_11> = <INTENT_11_L0TC> | <INTENT_11_L1TC> | <INTENT_11_L2TC> | <INTENT_11_REPHRASE>;
<INTENT_11_L0TC> = L0TC__ verb_pattern_01__ zmień (numer <PHONE_TYPE> <NAME> na <PHONE_NUMBER> | numer kòntaktu <NAME> na <PHONE_NUMBER> ò tipie <PHONE_TYPE>);

<INTENT_11_L1TC> = <INTENT_11_L1TC_1> | <INTENT_11_L1TC_2>;
<INTENT_11_L1TC_1> = L1TC__ verb_pattern_01__ pòprôw (numer <PHONE_TYPE> <NAME> na <PHONE_NUMBER> | numer kòntaktu <NAME> na <PHONE_NUMBER> ò tipie <PHONE_TYPE>);
<INTENT_11_L1TC_2> = L1TC__ verb_pattern_02__ aktualizuj (numer <PHONE_TYPE> <NAME> na <PHONE_NUMBER> | numer kòntaktu <NAME> na <PHONE_NUMBER> ò tipie <PHONE_TYPE>);

<INTENT_11_L2TC> = L2TC__ verb_pattern_01__ przepisz (numer <PHONE_TYPE> <NAME> na <PHONE_NUMBER> | numer kòntaktu <NAME> na <PHONE_NUMBER> ò tipie <PHONE_TYPE>);

<INTENT_11_REPHRASE> = REPHRASE__ (<INTENT_11_REPHRASE_1> | <INTENT_11_REPHRASE_2>);
<INTENT_11_REPHRASE_1> = verb_pattern_01__ zapisz nowi numer <PHONE_NUMBER> jakò <PHONE_TYPE> dlô kòntaktu <NAME>;
<INTENT_11_REPHRASE_2> = verb_pattern_02__ <NAME> mô nowi numer <PHONE_TYPE> <PHONE_NUMBER>;

#SLOTS
<EMAIL> = CONTACTS.SLOT.EMAIL;
