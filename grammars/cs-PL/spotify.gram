<INTENT_1_L1TC_2> = L1TC__ verb_pattern_02__ włącz [jakąs] mùzykã;
<INTENT_1_L1TC_3> = L1TC__ verb_pattern_03__ pùsc [jakąs] mùzykã;

<INTENT_1_L2TC> = <INTENT_1_L2TC_1> | <INTENT_1_L2TC_2> | <INTENT_1_L2TC_3>;
<INTENT_1_L2TC_1> = L2TC__ verb_pattern_01__ wëswietl [aplikacjã] spotify [i zagrôj [mie] [cos] | włącz [jakąs] mùzykã | pùsc mùzykã];
<INTENT_1_L2TC_2> = L2TC__ verb_pattern_02__ ùżëj [aplikacjã] spotify;
<INTENT_1_L2TC_3> = L2TC__ verb_pattern_03__ zagrôj [mie] [cos];

<INTENT_1_REPHRASE> = REPHRASE__ verb_pattern_01__ chcã pòsłëchac mùzyczi;

