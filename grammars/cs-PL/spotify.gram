<INTENT_1_L0TC_1> = L0TC__ verb_pattern_01__ òdemkni [aplikacjã] spotify;
<INTENT_1_L0TC_2> = L0TC__ verb_pattern_02__ ùruchòm [aplikacjã] spotify;

<INTENT_1_L1TC> = <INTENT_1_L1TC_1> | <INTENT_1_L1TC_2> | <INTENT_1_L1TC_3>;
