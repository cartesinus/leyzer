#JSGF V1.0;
#VUI-VERSION: 0.2.0;
public <S> = Websearch__ (OpenEngine__ <INTENT_1> | SearchTextOnEngine__ <INTENT_2> | SearchText__ <INTENT_3> | SearchImagesWithTextOnEngine__ <INTENT_4> | SearchImagesOnEngine__ <INTENT_5> | SearchImagesWithTextOnEngineWithWidthAndWithHeight__ <INTENT_6> | SearchImagesWithTextOnEngineWithWidthAndWithHeightAndWithCondition__ <INTENT_7>);

#INTENTS
##1) SEARCH WITH ENGINE
<INTENT_1> = <INTENT_1_L0TC> | <INTENT_1_L1TC> | <INTENT_1_L2TC> | <INTENT_1_REPHRASE>;
<INTENT_1_L0TC> = <INTENT_1_L0TC_1> | <INTENT_1_L0TC_2>;
<INTENT_1_L0TC_1> = L0TC__ verb_pattern_01__ szëkôj na <ENGINE>;
<INTENT_1_L0TC_2> = L0TC__ verb_pattern_02__ wëszëkôj (na | w) <ENGINE>;

<INTENT_1_L1TC> = <INTENT_1_L1TC_1> | <INTENT_1_L1TC_2>;
<INTENT_1_L1TC_1> = L1TC__ verb_pattern_01__ pòszëkôj na <ENGINE>;
<INTENT_1_L1TC_2> = L1TC__ verb_pattern_02__ chcã wëszëkac na <ENGINE>;

<INTENT_1_L2TC> = L2TC__ verb_pattern_01__ <ENGINE> [szëkôcz | szëkôcz];

<INTENT_1_REPHRASE> = REPHRASE__ verb_pattern_01__ wëszëkôj [cos] w internece;

##2) SEARCH TEXT WITH ENGINE
<INTENT_2> = <INTENT_2_L0TC> | <INTENT_2_L1TC> | <INTENT_2_L2TC> | <INTENT_2_REPHRASE>;
<INTENT_2_L0TC> = <INTENT_2_L0TC_1> | <INTENT_2_L0TC_2>;
<INTENT_2_L0TC_1> = L0TC__ verb_pattern_01__ <TXT_QUERY> (w | na) <ENGINE>;
<INTENT_2_L0TC_2> = L0TC__ verb_pattern_02__ <ENGINE> <TXT_QUERY>;

<INTENT_2_L1TC> = <INTENT_2_L1TC_1> | <INTENT_2_L1TC_2> | <INTENT_2_L1TC_3> | <INTENT_2_L1TC_4> | <INTENT_2_L1TC_5>;
<INTENT_2_L1TC_1> = L1TC__ verb_pattern_01__ szëkôj [mie] na <ENGINE> <TXT_QUERY>;
<INTENT_2_L1TC_2> = L1TC__ verb_pattern_02__ wëszëkôj [mie] na <ENGINE> <TXT_QUERY>;
<INTENT_2_L1TC_3> = L1TC__ verb_pattern_03__ naléz [mie] na <ENGINE> <TXT_QUERY>;
<INTENT_2_L1TC_4> = L1TC__ verb_pattern_04__ pòkôż [mie] na <ENGINE> <TXT_QUERY>;
<INTENT_2_L1TC_5> = L1TC__ verb_pattern_05__ chcã wëszëkac na <ENGINE> <TXT_QUERY>;

<INTENT_2_L2TC> = <INTENT_2_L2TC_1> | <INTENT_2_L2TC_2>;
<INTENT_2_L2TC_1> = L2TC__ verb_pattern_01__ pòkôż stronë [internetowé | www] (na | w) jaczich (nalézã | òdnalézã) <TXT_QUERY> (w | na) <ENGINE>;
<INTENT_2_L2TC_2> = L2TC__ verb_pattern_02__ wëswietl stronë [internetowé | www] (na | w) jaczich (nalézã | òdnalézã) <TXT_QUERY> (w | na) <ENGINE>;

<INTENT_2_REPHRASE> = REPHRASE__ verb_pattern_01__ przeszëkôj internet w pòszukiwanim <TXT_QUERY> przy użyciu <ENGINE>;

##3) SEARCH TEXT
<INTENT_3> = <INTENT_3_L0TC> | <INTENT_3_L1TC> | <INTENT_3_L2TC> | <INTENT_3_REPHRASE>;
<INTENT_3_L0TC> = <INTENT_3_L0TC_1> | <INTENT_3_L0TC_2> | <INTENT_3_L0TC_3>;
<INTENT_3_L0TC_1> = L0TC__ verb_pattern_01__ <TXT_QUERY> [w séce | w internece];
<INTENT_3_L0TC_2> = L0TC__ verb_pattern_02__ szëkôj <TXT_QUERY> [w séce | w internece];
<INTENT_3_L0TC_3> = L0TC__ verb_pattern_03__ wëszëkôj <TXT_QUERY> [w séce | w internece];

<INTENT_3_L1TC> = <INTENT_3_L1TC_1> | <INTENT_3_L1TC_2> | <INTENT_3_L1TC_3> | <INTENT_3_L1TC_4> | <INTENT_3_L1TC_5>;
<INTENT_3_L1TC_1> = L1TC__ verb_pattern_01__ szëkôj infòrmacji ò <TXT_QUERY> [w séce | w internece];
<INTENT_3_L1TC_2> = L1TC__ verb_pattern_02__ wëszëkôj [mie] <TXT_QUERY> [w séce | w internece];
<INTENT_3_L1TC_3> = L1TC__ verb_pattern_03__ naléz [mie] <TXT_QUERY> [w séce | w internece];
<INTENT_3_L1TC_4> = L1TC__ verb_pattern_04__ pòkôż [mie] <TXT_QUERY> [w séce | w internece];
<INTENT_3_L1TC_5> = L1TC__ verb_pattern_05__ chcã wëszëkac <TXT_QUERY> [w séce | w internece];

<INTENT_3_L2TC> = <INTENT_3_L2TC_1> | <INTENT_3_L2TC_2>;
<INTENT_3_L2TC_1> = L2TC__ verb_pattern_01__ pòkôż stronë [internetowé | www] (na | w) jaczich (nalézã | òdnalézã) <TXT_QUERY>;
<INTENT_3_L2TC_2> = L2TC__ verb_pattern_02__ wëswietl stronë [internetowé | www] (na | w) jaczich (nalézã | òdnalézã) <TXT_QUERY>;

<INTENT_3_REPHRASE> = REPHRASE__ verb_pattern_01__ przeszëkôj internet w pòszukiwanim <TXT_QUERY>;

##4) SEARCH IMAGE WITH ENGINE
<INTENT_4> = <INTENT_4_L0TC> | <INTENT_4_L1TC> | <INTENT_4_L2TC> | <INTENT_4_REPHRASE>;
<INTENT_4_L0TC> = <INTENT_4_L0TC_1> | <INTENT_4_L0TC_2>;
<INTENT_4_L0TC_1> = L0TC__ verb_pattern_01__ wëszëkôj <IMAGES> [jaczé pasëją do | pasëjącé do | ò] <IMG_QUERY> (na | w) <ENGINE>;
<INTENT_4_L0TC_2> = L0TC__ verb_pattern_02__ szëkôj <IMAGES> [jaczé pasëją do | pasëjącé do | ò] <IMG_QUERY> (na | w) <ENGINE>;

<INTENT_4_L1TC> = <INTENT_4_L1TC_1> | <INTENT_4_L1TC_2> | <INTENT_4_L1TC_3>;
<INTENT_4_L1TC_1> = L1TC__ verb_pattern_01__ pòkôż <IMAGES> [jaczé pasëją do | pasëjącé do | ò] <IMG_QUERY> (na | w) <ENGINE>;
<INTENT_4_L1TC_2> = L1TC__ verb_pattern_02__ wëswietl <IMAGES> [jaczé pasëją do | pasëjącé do | ò] <IMG_QUERY> (na | w) <ENGINE>;
<INTENT_4_L1TC_3> = L1TC__ verb_pattern_03__ naléz <IMAGES> [jaczé pasëją do | pasëjącé do | ò] <IMG_QUERY> (na | w) <ENGINE>;

<INTENT_4_L2TC> = L2TC__ verb_pattern_01__ chcã òbaczëc <IMAGES> [jaczé pasëją do | pasëjącé do | ò] <IMG_QUERY> (na | w) <ENGINE>;

<INTENT_4_REPHRASE> = REPHRASE__ verb_pattern_01__ naléz szlachùjącé òbrazë do <IMG_QUERY> (na | w) <ENGINE>;

##5) SEARCH IMAGE
<INTENT_5> = <INTENT_5_L0TC> | <INTENT_5_L1TC> | <INTENT_5_L2TC> | <INTENT_5_REPHRASE>;
<INTENT_5_L0TC> = <INTENT_5_L0TC_1> | <INTENT_5_L0TC_2>;
<INTENT_5_L0TC_1> = L0TC__ verb_pattern_01__ wëszëkôj <IMAGES> [jaczé pasëją do | pasëjącé do | ò] <IMG_QUERY>;
<INTENT_5_L0TC_2> = L0TC__ verb_pattern_02__ szëkôj <IMAGES> [jaczé pasëją do | pasëjącé do | ò] <IMG_QUERY>;

<INTENT_5_L1TC> = <INTENT_5_L1TC_1> | <INTENT_5_L1TC_2> | <INTENT_5_L1TC_3>;
<INTENT_5_L1TC_1> = L1TC__ verb_pattern_01__ pòkôż <IMAGES> [jaczé pasëją do | pasëjącé do | ò] <IMG_QUERY>;
<INTENT_5_L1TC_2> = L1TC__ verb_pattern_02__ wëswietl <IMAGES> [jaczé pasëją do | pasëjącé do | ò] <IMG_QUERY>;
<INTENT_5_L1TC_3> = L1TC__ verb_pattern_03__ naléz <IMAGES> [jaczé pasëją do | pasëjącé do | ò] <IMG_QUERY>;

<INTENT_5_L2TC> = L2TC__ verb_pattern_01__ chcã òbaczëc <IMAGES> [jaczé pasëją do | pasëjącé do | ò] <IMG_QUERY>;

<INTENT_5_REPHRASE> = REPHRASE__ verb_pattern_01__ naléz szlachùjącé òbrazë do <IMG_QUERY>;

##6) SEARCH IMAGE WITH WIDTH AND HEIGHT
<INTENT_6> = <INTENT_6_L0TC> | <INTENT_6_L1TC> | <INTENT_6_L2TC> | <INTENT_6_REPHRASE>;
<INTENT_6_L0TC> = <INTENT_6_L0TC_1> | <INTENT_6_L0TC_2>;
<INTENT_6_L0TC_1> = L0TC__ verb_pattern_01__ wëszëkôj <IMAGES> [jaczé pasëją do | pasëjącé do | ò] <IMG_QUERY> ò rozmiarze <WIDTH> na <HEIGHT>;
<INTENT_6_L0TC_2> = L0TC__ verb_pattern_02__ szëkôj <IMAGES> [jaczé pasëją do | pasëjącé do | ò] <IMG_QUERY> ò rozmiarze <WIDTH> na <HEIGHT>;

<INTENT_6_L1TC> = <INTENT_6_L1TC_1> | <INTENT_6_L1TC_2> | <INTENT_6_L1TC_3>;
<INTENT_6_L1TC_1> = L1TC__ verb_pattern_01__ pòkôż <IMAGES> [jaczé pasëją do | pasëjącé do | ò] <IMG_QUERY> ò rozmiarze <WIDTH> na <HEIGHT>;
<INTENT_6_L1TC_2> = L1TC__ verb_pattern_02__ wëswietl <IMAGES> [jaczé pasëją do | pasëjącé do | ò] <IMG_QUERY> ò rozmiarze <WIDTH> na <HEIGHT>;
<INTENT_6_L1TC_3> = L1TC__ verb_pattern_03__ naléz <IMAGES> [jaczé pasëją do | pasëjącé do | ò] <IMG_QUERY> ò rozmiarze <WIDTH> na <HEIGHT>;

<INTENT_6_L2TC> = L2TC__ verb_pattern_01__ chcã òbaczëc <IMAGES> [jaczé pasëją do | pasëjącé do | ò] <IMG_QUERY> ò rozmiarze <WIDTH> na <HEIGHT>;

<INTENT_6_REPHRASE> = REPHRASE__ verb_pattern_01__ naléz szlachùjącé òbrazë do <IMG_QUERY> ò rozmiarze <WIDTH> na <HEIGHT>;

##7) SEARCH IMAGE WITH WIDTH, HEIGHT OR MORE OR LESS
<INTENT_7> = <INTENT_7_L0TC> | <INTENT_7_L1TC> | <INTENT_7_L2TC> | <INTENT_7_REPHRASE>;
<INTENT_7_L0TC> = <INTENT_7_L0TC_1> | <INTENT_7_L0TC_2>;
<INTENT_7_L0TC_1> = L0TC__ verb_pattern_01__ wëszëkôj <IMAGES> [jaczé pasëją do | pasëjącé do | ò] <IMG_QUERY> i <IMG_COND> niż <WIDTH> [na <HEIGHT>];
<INTENT_7_L0TC_2> = L0TC__ verb_pattern_02__ szëkôj <IMAGES> [jaczé pasëją do | pasëjącé do | ò] <IMG_QUERY> i <IMG_COND> niż <WIDTH> [na <HEIGHT>];

<INTENT_7_L1TC> = <INTENT_7_L1TC_1> | <INTENT_7_L1TC_2> | <INTENT_7_L1TC_3>;
<INTENT_7_L1TC_1> = L1TC__ verb_pattern_01__ pòkôż <IMAGES> [jaczé pasëją do | pasëjącé do | ò] <IMG_QUERY> i <IMG_COND> niż <WIDTH> [na <HEIGHT>];
<INTENT_7_L1TC_2> = L1TC__ verb_pattern_02__ wëswietl <IMAGES> [jaczé pasëją do | pasëjącé do | ò] <IMG_QUERY> i <IMG_COND> niż <WIDTH> [na <HEIGHT>];
<INTENT_7_L1TC_3> = L1TC__ verb_pattern_03__ naléz <IMAGES> [jaczé pasëją do | pasëjącé do | ò] <IMG_QUERY> i <IMG_COND> niż <WIDTH> [na <HEIGHT>];

<INTENT_7_L2TC> = L2TC__ verb_pattern_01__ chcã òbaczëc <IMAGES> [jaczé pasëją do | pasëjącé do | ò] <IMG_QUERY> i <IMG_COND> niż <WIDTH> [na <HEIGHT>];

<INTENT_7_REPHRASE> = REPHRASE__ verb_pattern_01__ naléz szlachùjącé òbrazë do <IMG_QUERY> i <IMG_COND> niż <WIDTH> [na <HEIGHT>];

#SLOTS
<ENGINE> = bing | google | duckduckgo;
<TXT_QUERY> = WEBSEARCH.SLOT.TXT_QUERY;
<IMG_QUERY> = WEBSEARCH.SLOT.IMG_QUERY;
<WIDTH> = 800;
<HEIGHT> = 600;
<IMG_COND> = szerszi | wiãkszi | wãższi | mniészi;

#LANG. COMPONENTS
<IMAGES> = òbrazë | òbrôzczi | òdjimczi;
