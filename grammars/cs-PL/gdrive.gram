<INTENT_13_L1TC> = L1TC__ verb_pattern_01__ dôj przëstãp [do edicje | òdczëtu | òdczëtu i zôpisu] do <FILE_NAME> <MAIL>;

<INTENT_13_L2TC> = L2TC__ verb_pattern_01__ niech <MAIL> mô przëstãp [do edicje | òdczëtu | òdczëtu i zôpisu] lopkù <FILE_NAME>;

<INTENT_13_REPHRASE> = <INTENT_13_REPHRASE_1> | <INTENT_13_REPHRASE_2>;
<INTENT_13_REPHRASE_1> = REPHRASE__ verb_pattern_01__ pòdzél sã tim lopkã z <MAIL>;
<INTENT_13_REPHRASE_2> = REPHRASE__ verb_pattern_02__ chcã robic nad tim lopkã z <MAIL>;

#SLOTS
<MIME_TYPE> = GDRIVE.SLOT.MIME_TYPE;
<FILE_NAME> = GDRIVE.SLOT.FILE_NAME;
<FILE_SIZE> = GDRIVE.SLOT.FILE_SIZE;
<TIME> = GDRIVE.SLOT.TIME;
<MAIL> = GDRIVE.SLOT.MAIL;

#LANG. COMPONENTS
<MY_GDRIVE_FILES> = mòje lopczi (z | na | w) (google drive | diskù google);
